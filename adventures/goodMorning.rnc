

datatypes xsd = "https://www.w3.org/2001/XMLSchema-datatypes"


start = element xml {
	source,
	poem
}

source = element source {
	title, 
	author,
	date
}

poem = element poem {
	title,
	lg*
}

title = element title {
	attribute level { "book" | "inner" },
	text
}

author = element author {
	text
}

date = element date {
	attribute n { xsd:gYear }
}

lg = element lg {
    ln*
}


ln = element ln {
	attribute n { xsd:positiveInteger },
	mixed {
	(place | placeName | motif)*
	}
}

place = element place { 
	attribute ref { xsd:string },
	text
}

placeName = element place {
	attribute ref { xsd:string },
	text
}

motif = element motif {
	text
}
