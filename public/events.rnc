

start = element events {
	track*
}

track = element track {
attribute type { text },

attribute name { text },

event*
}

event = element event {
	title,
	date,
	date,
	description,
	lat,
	lon
}



title = element title {
	text
}

date = element date {
	attribute type { text },
	year,
	month,
	era
}

year = element year {
	text
}

month = element month {
	text
}

era = element era {
	text
}

description = element description {
	text
}

lat = element lat {
	text
}

lon = element lon {
	text
}
