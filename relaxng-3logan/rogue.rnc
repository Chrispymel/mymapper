datatypes xsd = "http://www.w3.org/2001/XMLSchema-datatypes"

start = element games {
    game*
}

game = element game {
    patternName,
    title,
    genre,
    year,
    rating
}

title = element title {
    text
}

genre = element genre {
    text
}

year = element year {
    xsd:gYear
}

patternName = element name {
	text
}

rating = element rating {
    xsd:integer {
	minInclusive = "1",
	maxInclusive = "10"
	}
}
